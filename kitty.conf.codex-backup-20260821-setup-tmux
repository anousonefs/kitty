shell /usr/local/bin/fish

# Font
font_family MesloLGS NF
# italic_font auto
# bold_italic_font auto
font_size 14.0

shell_integration enabled
allow_hyperlinks yes
editor nvim

# Theme
foreground #f8f8f2
background #000000
url_color #d65c9d

window_border_width 0.5pt
window_resize_step_cells 2
window_resize_step_lines 2
initial_window_width 640
initial_window_height 400
draw_minimal_borders yes
inactive_text_alpha 0.7
macos_titlebar_color background
macos_thicken_font 0.05
active_border_color none

# default layout is vertical splits only
enabled_layouts splits
enable_audio_bell no

# Cursor
cursor #8fee96

term xterm-256color
background_opacity 0.85 

color0  #000000
color8  #44475a

color1  #ff5555
color9  #ff5555

color2  #50fa7b
color10 #50fa7b

color3  #f1fa8c
color11 #f1fa8c

color4  #bd93f9
color12 #bd93f9

color5  #ff79c6
color13 #ff79c6

color6  #8be9fd
color14 #8be9fd

color7  #bbbbbb
color15 #ffffff

hide_window_decorations titlebar-only
copy_on_select yes

# tmux
map cmd+a send_text application \u0001
map cmd+t send_text application  \u0001\u0063
map cmd+y send_text application  \u0001\u004c
map cmd+s send_text application  \u0001\u0073
map cmd+z send_text application  \u0001\u007a
map cmd+w send_text application  \u0001\u0078
map cmd+shift+n send_text application  \u0001\u0025
map cmd+shift+m send_text application  \u0001\u0022
map cmd+shift+comma send_text application  \u0001\u0024
map cmd+comma send_text application  \u0001\u002c
map cmd+d send_text application  \u0004
map cmd+n send_key ctrl+n
map cmd+p send_key ctrl+p

map cmd+1 send_text application \u0001\u0031
map cmd+2 send_text application \u0001\u0032
map cmd+3 send_text application \u0001\u0033
map cmd+4 send_text application \u0001\u0034
map cmd+5 send_text application \u0001\u0035
map cmd+6 send_text application \u0001\u0036
map cmd+7 send_text application \u0001\u0037
map cmd+8 send_text application \u0001\u0038
map cmd+9 send_text application \u0001\u0039

# vim
map cmd+m send_text application \u0019

map cmd+h send_key ctrl+h
map cmd+j send_key ctrl+j
map cmd+k send_key ctrl+k
map cmd+l send_key ctrl+l


map cmd+r send_text application \u0012

map cmd+o send_text application \u000F
map cmd+u send_text application \u0015
map cmd+i send_text application \u0009 

map cmd+e send_key ctrl+e
map cmd+g send_key ctrl+g


map cmd+f send_key ctrl+f

map cmd+c copy_to_clipboard
map cmd+v paste_from_clipboard 

map cmd+shift+r load_config_file

map cmd+x send_text all \x02\x54
